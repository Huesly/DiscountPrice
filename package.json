{
  "name": "mcp-price-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Falabella price tracker: Playwright collector + MariaDB + price analysis + MCP server",
  "type": "module",
  "scripts": {
    "discover": "tsx src/discovery/probe.ts",
    "collector": "tsx src/collector.ts",
    "collector:1": "tsx src/collector.ts --group=1",
    "collector:2": "tsx src/collector.ts --group=2",
    "collector:exito": "tsx src/collector.ts --store=exito",
    "collector:exito:1": "tsx src/collector.ts --store=exito --group=1",
    "collector:exito:2": "tsx src/collector.ts --store=exito --group=2",
    "collector:exito:cali": "tsx src/collector.ts --store=exito --city=Cali",
    "collector:exito:bucaramanga": "tsx src/collector.ts --store=exito --city=Bucaramanga",
    "collector:homecenter": "tsx src/collector.ts --store=homecenter",
    "collector:homecenter:1": "tsx src/collector.ts --store=homecenter --group=1",
    "collector:homecenter:2": "tsx src/collector.ts --store=homecenter --group=2",
    "collector:ikea": "tsx src/collector.ts --store=ikea --city=Cali",
    "analyze": "tsx src/analyzer.ts",
    "match": "tsx src/match.ts",
    "dedupe": "tsx src/dedupe.ts",
    "mcp": "tsx src/mcp/server.ts",
    "init-db": "tsx src/db/init.ts",
    "migrate": "tsx src/db/migrate.ts",
    "api": "tsx src/api/server.ts",
    "schedule": "tsx src/scheduler.ts",
    "collect:all": "npm run collector && npm run collector:exito:cali && npm run collector:homecenter && npm run match"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "lucide-react": "^1.31.0",
    "mysql2": "^3.23.3",
    "node-cron": "^4.6.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
